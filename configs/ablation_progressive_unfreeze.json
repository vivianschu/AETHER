{
  "_comment": "Ablation vs default.json: unfreeze the last 4 ESM2 layers after epoch 3. Note this discards the precomputed MHC cache at that point (the embeddings would go stale), so epochs 4+ run much slower and need a smaller batch. Use a lower lr than a frozen run.",
  "data_dir": "data/mhcattnnet/classI_peptide_split",
  "model_name": "facebook/esm2_t33_650M_UR50D",
  "freeze_backbone": true,
  "precompute_mhc": true,
  "d_proj": 512,
  "num_heads": 8,
  "dropout": 0.1,
  "num_interaction_layers": 2,
  "use_self_attn": true,
  "use_product_head": true,
  "seed": 1337,
  "batch_size": 16,
  "epochs": 8,
  "lr": 0.0001,
  "weight_decay": 0.01,
  "num_workers": 4,
  "amp": true,
  "grad_clip": 1.0,
  "pos_weight": "none",
  "auc_label_threshold": 0.5,
  "lr_scheduler": "cosine",
  "warmup_steps": 200,
  "eval_every_steps": 2000,
  "eval_max_batches": 50,
  "best_metric": "within_allele_auroc",
  "unfreeze_after_epoch": 3,
  "unfreeze_num_layers": 4,
  "split_group": "peptide"
}
